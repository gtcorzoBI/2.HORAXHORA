		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2024, 1, 1), TODAY()), 
				    "Año", YEAR([Date]),
				    "Mes", FORMAT([Date], "MMMM"),
				    "Mes N°", MONTH([Date]),
				    "Trimestre", "Q" & FORMAT([Date], "Q"),
				    "Día", DAY([Date]),
				    "Día Semana", FORMAT([Date], "dddd"),
				    "Número Semana", WEEKNUM([Date])
				)
				```

	annotation PBI_Id = 44e659382cd042b3bddb41f425e2b51b

