	partition CalendarioEntregas = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2024, 1, 1), TODAY()), 
				    "Año", YEAR([Date]),
				    "Mes", FORMAT([Date], "MMMM"),
				    "Mes N°", MONTH([Date]),
				    "Trimestre", "Q" & FORMAT([Date], "Q"),
				    "Día", DAY([Date]),
				    "Día Semana", FORMAT([Date], "dddd"),
				    "Número Semana", WEEKNUM([Date])
				)
				```

	annotation PBI_Id = 65407feb1f744130a31edeae81ca1a4d

