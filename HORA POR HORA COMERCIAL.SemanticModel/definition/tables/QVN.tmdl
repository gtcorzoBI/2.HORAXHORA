	column 'Grupo Venta' =
			SWITCH(
				TRUE,
				ISBLANK('QVN'[TIPO_DE_VENTA]),
				"(En blanco)",
				'QVN'[TIPO_DE_VENTA] IN {"VENTA FLOTILLA CONTADO",
					"VENTA FLOTILLA CREDITO",
					"VENTA FLOTILLA FINANCIERA MARCA",
					"VENTA FLOTILLA OTRAS FINANCIERAS"},
				"FLOTILLA",
				'QVN'[TIPO_DE_VENTA] IN {"VENTA CONTADO MENUDEO",
					"VENTA CONTADO MENUDEO SR",
					"VENTA CONTADO P8",
					"VENTA CREDITO INTERNO",
					"VENTA CREDITO MENUDEO",
					"VENTA DEMO CREDITO",
					"VENTA DEMO MENUDEO",
					"VENTA FINANCIERA MARCA MENUDEO",
					"VENTA OTRAS FINANCIERAS MENUDEO",
					"Venta Sicrea"},
				"MENUDEO",
				'QVN'[TIPO_DE_VENTA]
			)
		lineageTag: bde71462-8d57-40b6-8ee4-c8aef4b84a0b
		summarizeBy: none

		extendedProperty GroupingMetadata =
				{
				  "version": 0,
				  "groupedColumns": [
				    {
				      "Column": {
				        "Expression": {
				          "SourceRef": {
				            "Entity": "QVN"
				          }
				        },
				        "Property": "TIPO_DE_VENTA"
				      }
				    }
				  ]
				}

		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"q","Entity":"QVN"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"q"}},"Property":"TIPO_DE_VENTA"}}],"GroupItems":[{"DisplayName":"(En blanco)","BlankDefaultPlaceholder":true},{"DisplayName":"FLOTILLA","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"q"}},"Property":"TIPO_DE_VENTA"}}],"Values":[[{"Literal":{"Value":"'VENTA FLOTILLA CONTADO'"}}],[{"Literal":{"Value":"'VENTA FLOTILLA CREDITO'"}}],[{"Literal":{"Value":"'VENTA FLOTILLA FINANCIERA MARCA'"}}],[{"Literal":{"Value":"'VENTA FLOTILLA OTRAS FINANCIERAS'"}}]]}}},{"DisplayName":"MENUDEO","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"q"}},"Property":"TIPO_DE_VENTA"}}],"Values":[[{"Literal":{"Value":"'VENTA CONTADO MENUDEO'"}}],[{"Literal":{"Value":"'VENTA CONTADO MENUDEO SR'"}}],[{"Literal":{"Value":"'VENTA CONTADO P8'"}}],[{"Literal":{"Value":"'VENTA CREDITO INTERNO'"}}],[{"Literal":{"Value":"'VENTA CREDITO MENUDEO'"}}],[{"Literal":{"Value":"'VENTA DEMO CREDITO'"}}],[{"Literal":{"Value":"'VENTA DEMO MENUDEO'"}}],[{"Literal":{"Value":"'VENTA FINANCIERA MARCA MENUDEO'"}}],[{"Literal":{"Value":"'VENTA OTRAS FINANCIERAS MENUDEO'"}}],[{"Literal":{"Value":"'Venta Sicrea'"}}]]}}}]}

